generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  PENDING
  TRAINED
}

enum ChannelType {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  WIDGET
  SHOPIFY
  WOOCOMMERCE
}

enum ConversationStatus {
  AI_MANAGED
  ACTIVE
  CLOSED
}

enum Sender {
  CUSTOMER
  AI
  MERCHANT
}

enum OrderStatus {
  PROCESSING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Merchant {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  name         String
  phone        String?
  avatarUrl    String?
  // Incremented on logout (and password change) so previously issued session JWTs fail requireAuth.
  tokenVersion Int      @default(0)
  store        Store?
  createdAt    DateTime @default(now())
}

model Store {
  id            String         @id @default(cuid())
  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  merchantId    String         @unique
  name          String
  tone          String         @default("Direct, helpful, and highly sophisticated.")
  style         String         @default("narrative")
  customInstructions String    @default("")
  // If true, the AI can finalize a real order the instant a customer confirms it, even
  // when AI Copilot is off (Active/manual mode) for that conversation. Default false:
  // auto-finalize only applies in AI Managed (autopilot) mode, mirroring how auto-send
  // already works for replies — a merchant must explicitly opt in to full automation.
  autoFinalizeOrdersAlways Boolean @default(false)
  // Greeting the AI leads with on a customer's very first message in a brand-new
  // conversation on a real channel (Messenger/WhatsApp/Instagram). Null/empty = no greeting.
  openingText     String?
  openingImageUrl String?
  widgetKey     String         @unique @default(cuid())
  // Business contact & address fields (all optional; set via merchant settings)
  businessPhone String?
  businessType  String?
  website       String?
  streetAddress String?
  city          String?
  country       String?
  // Toggle to control whether AI should share business contact info with customers
  shareBusinessInfo Boolean @default(true)
  // Exactly one catalog source may be active at a time. CUSTOM means manual entry.
  catalogSource String  @default("CUSTOM")
  products      Product[]
  channels      Channel[]
  conversations Conversation[]
  orders        Order[]
  appointments  Appointment[]
  knowledgeDocuments KnowledgeDocument[]
  createdAt     DateTime       @default(now())
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  store     Store    @relation(fields: [storeId], references: [id])
  storeId   String
  title     String
  body      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, enabled])
}

model Product {
  id            String        @id @default(cuid())
  store         Store         @relation(fields: [storeId], references: [id])
  storeId       String
  name          String
  sku           String
  price         Decimal
  inventory     Int
  description   String?
  imageUrl      String?
  rawAttributes Json?
  status        ProductStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  // Shopify's variant ID, when this product was synced from a connected Shopify store.
  // Null for manually-entered products. Lets a re-sync detect renames without duplicating.
  externalId    String?

  @@unique([storeId, sku])
}

model Channel {
  id          String      @id @default(cuid())
  store       Store       @relation(fields: [storeId], references: [id])
  storeId     String
  type        ChannelType
  connected   Boolean     @default(false)
  credentials Json?
  // Provider-scoped identity (Facebook Page ID, IG business account ID,
  // WhatsApp phone-number ID, Shopify shop domain). NULL when disconnected.
  // Uniqueness is per ChannelType so IDs from different providers never collide.
  externalId  String?

  @@unique([storeId, type])
  // One connected provider identity may belong to at most one store.
  // PostgreSQL treats NULLs as distinct, so disconnected rows (externalId null) are fine.
  @@unique([type, externalId])
}

// Public comments (Facebook / Instagram posts) the open-source comment workers have
// already handled, so a comment is never answered twice. replied=false marks comments
// that were only recorded (pre-existing backlog or skipped) and never answered.
model RepliedComment {
  id          String      @id @default(cuid())
  storeId     String
  channelType ChannelType
  commentId   String
  postId      String?
  replied     Boolean     @default(true)
  createdAt   DateTime    @default(now())

  @@unique([storeId, channelType, commentId])
  @@index([storeId, channelType])
}

// WhatsApp (Baileys) auth credentials and signal keys, kept in the database so a pairing
// survives redeploys on hosts with an ephemeral filesystem. Values are Baileys-serialized JSON.
model WhatsAppAuthState {
  channelId String
  key       String
  value     String @db.Text

  @@id([channelId, key])
}

// Idempotency ledger for webhook/events that do not create a Message row
// (e.g. Meta comment bots). Message.externalId covers Messenger/WA/IG DMs.
// Stores only provider + event id — never full payloads or customer PII.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
}

model Conversation {
  id             String             @id @default(cuid())
  store          Store              @relation(fields: [storeId], references: [id])
  storeId        String
  channelType    ChannelType
  externalUserId String?
  customerName   String?
  // Customer's profile photo URL, fetched from Meta's Graph API for Facebook/Instagram
  // (never available for WhatsApp — the platform doesn't expose it). Meta's returned
  // URLs are short-lived signed CDN links (observed Instagram URLs expiring within
  // ~24h) — avatarFetchedAt tracks when this was last fetched so it gets refreshed
  // periodically instead of going permanently stale after the first successful fetch.
  avatarUrl      String?
  avatarFetchedAt DateTime?
  status         ConversationStatus @default(AI_MANAGED)
  isComplaint    Boolean            @default(false)
  cart           Json?
  // Shipping address the AI has extracted from the conversation, if the customer
  // mentioned one — pre-fills (but doesn't auto-submit) the Generate Order form.
  detectedAddress String?
  // Customer's phone number, kept separate from detectedAddress.
  detectedPhone   String?
  // Added directly against the shared DB from another machine (order-confirmation flow
  // in progress there as of 2026-07-30) — field meanings inferred from name/type only,
  // since the corresponding server.ts logic hasn't been pushed to git yet.
  orderConfirmationRequested Boolean @default(false)
  orderConfirmed             Boolean @default(false)
  orderSummaryShown          Boolean @default(false)
  awaitingQuantityFor        String?
  // Added directly against the shared DB from another machine — Archive/Spam Inbox filters.
  isArchived     Boolean            @default(false)
  isSpam         Boolean            @default(false)
  messages       Message[]
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())

  @@unique([storeId, channelType, externalUserId])
  @@index([storeId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  sender         Sender
  text           String
  // Set when this message includes a product photo (AI-sent or merchant-sent).
  imageUrl       String?
  audioUrl       String?
  transcript     String?
  mediaType      String?
  // True for an AI-drafted reply awaiting merchant approval (Copilot off / manual mode) —
  // not yet delivered to the real customer. False for anything already sent/delivered.
  pending        Boolean      @default(false)
  // Meta's message id, when this row originated from a webhook event. Used to make webhook
  // processing idempotent, since Meta's delivery is "at-least-once" and may redeliver.
  externalId     String?      @unique
  meta           Json?
  createdAt      DateTime     @default(now())
}

model Appointment {
  id                   String            @id @default(cuid())
  store                Store             @relation(fields: [storeId], references: [id])
  storeId              String
  conversationId       String?
  customerName         String
  customerPhone        String?
  service              String
  startsAt             DateTime
  endsAt               DateTime
  status               AppointmentStatus @default(REQUESTED)
  advanceAmount        Decimal?
  advancePaymentMethod String?
  advanceTransactionId String?
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([storeId, startsAt])
  @@index([storeId, status])
}

model Order {
  id             String      @id @default(cuid())
  store          Store       @relation(fields: [storeId], references: [id])
  storeId        String
  conversationId String?
  items          Json
  customerName   String
  customerPhone  String?
  address        String
  status         OrderStatus @default(PROCESSING)
  total          Decimal
  createdAt      DateTime    @default(now())

  @@index([storeId])
}

// Short-lived opaque handoff codes for OAuth (connect / pending selection / Google login
// exchange). Browser only ever sees `code` — never session JWTs or provider access tokens.
model OAuthHandoff {
  id         String    @id @default(cuid())
  code       String    @unique
  purpose    String
  storeId    String?
  merchantId String?
  payload    Json?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}
